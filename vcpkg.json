{
  "name": "semantic-splinter",
  "version": "0.1.0",
  "description": "Format-aware diff, three-way merge, and patch",
  "license": "MIT",
  "builtin-baseline": "b08975f4fdf01ad9a5c08db8f1953a57d11e8b26",
  "dependencies": [
    "nlohmann-json",
    "xxhash",
    "zlib",
    "zstd"
  ],
  "features": {
    "tests": {
      "description": "Catch2 test suite",
      "dependencies": [
        "catch2"
      ]
    },
    "png": {
      "description": "PNG format module",
      "dependencies": [
        "libpng",
        "zlib"
      ]
    },
    "zip": {
      "description": "ZIP format module (deflate, zstd members)",
      "dependencies": [
        "zlib",
        "zstd"
      ]
    },
    "tar": {
      "description": "TAR format module (gzip, zstd, xz, bzip2 wrappers)",
      "dependencies": [
        {
          "name": "bzip2",
          "default-features": false
        },
        "liblzma",
        "zlib",
        "zstd"
      ]
    },
    "json": {
      "description": "JSON format module"
    },
    "xml": {
      "description": "XML format module",
      "dependencies": [
        "expat"
      ]
    },
    "csv": {
      "description": "CSV/TSV format module"
    },
    "jpeg": {
      "description": "JPEG format module (DCT-domain merge)",
      "dependencies": [
        {
          "name": "libjpeg-turbo",
          "default-features": false
        }
      ]
    },
    "svg": {
      "description": "SVG format module (on the XML module; zlib for .svgz)",
      "dependencies": [
        "expat",
        "zlib"
      ]
    },
    "sqlite": {
      "description": "SQLite format module",
      "dependencies": [
        {
          "name": "sqlite3",
          "default-features": false,
          "features": [
            "fts5",
            "json1",
            "rtree",
            "session"
          ]
        }
      ]
    }
  }
}
